# Database
DATABASE_URL="postgresql://bookflow:bookflow@localhost:5432/bookflow?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# App
APP_NAME="BookFlow"
UPLOAD_DIR="./uploads"

# AI (mock | gemini | auto)
# gemini/auto: use Gemini when GEMINI_API_KEY is set; mock is backup on failure
AI_PROVIDER="gemini"

# Google Gemini (keep secret; never commit real keys)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
GEMINI_TTS_VOICE="Kore"

# Optional other providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
